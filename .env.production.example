# ============================================================================
# Fluxberry — PRODUCTION environment template (fluxberry.in)
#
# This is .env.example with production values filled in where they're fixed
# (domains, flags) and everything secret left blank for you to fill from your
# host's secret manager (Railway/Render/Fly "Variables" tab, Vercel "Environment
# Variables", etc). Never commit a filled-in copy of this file.
#
# See the chat/runbook for exactly where each secret comes from.
# ============================================================================

# ---- App identity ------------------------------------------------------
APP_NAME=Fluxberry

# ---- Runtime -------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Every real browser origin that will call the API. Comma-separated, no
# trailing slashes. Add both apex and www if you serve both.
CORS_ORIGINS=https://fluxberry.in,https://www.fluxberry.in
# The externally-reachable URL of THIS backend (matches NEXT_PUBLIC_API_URL
# below). The app derives this from the incoming request by default, so it's
# usually optional — only set it if the backend sits behind infra where the
# request's own host/protocol doesn't match the public one (e.g. an internal
# load balancer). Also used to build the Google Calendar OAuth redirect URI.
PUBLIC_API_URL=https://api.fluxberry.in

# ---- Database --------------------------------------------------------------
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
MONGODB_URI=

# ---- Auth (Supabase) -------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# MUST be false in production — the test-token path is a full auth bypass.
AUTH_ALLOW_TEST_TOKENS=false
AUTH_TEST_TOKEN_SECRET=
# MUST be false in production — bypasses real auth and grants owner everywhere.
AUTH_BYPASS_ENABLED=false

# ---- Providers: master switch ----------------------------------------------
MOCK_EXTERNAL_SERVICES=false

# ---- AI provider -----------------------------------------------------------
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
# Cheaper model for high-volume extraction (resume parse, screening, search-prompt parse).
# Blank → claude-haiku-4-5 on Anthropic. Credit prices assume this split.
AI_MODEL_FAST=

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Fluxberry <noreply@fluxberry.in>

# ---- Candidate messaging ----------------------------------------------------
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# ---- Billing (Dodo Payments) ------------------------------------------------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=live_mode
DODO_PRO_PRODUCT_ID=
DODO_PRO_PRODUCT_ID_ANNUAL=
DODO_MAX_PRODUCT_ID=
DODO_MAX_PRODUCT_ID_ANNUAL=
# One-time products for AI-credit top-up packs (250/$60, 500/$90, 1000/$150).
DODO_CREDITS_250_PRODUCT_ID=
DODO_CREDITS_500_PRODUCT_ID=
DODO_CREDITS_1000_PRODUCT_ID=

# ---- Object storage (S3-compatible: Cloudflare R2 or AWS S3) ---------------
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=fluxberry-prod
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Required in practice for logos/resumes to resolve to a stable public URL —
# your bucket's public base URL or CDN domain (e.g. a Cloudflare R2 custom
# domain, or CloudFront/S3 static site URL).
STORAGE_PUBLIC_URL=

# ---- Coding execution (Judge0) — only if FEATURE_CODING_ASSESSMENT=true ----
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_MODE=token
JUDGE0_RAPIDAPI_HOST=

# ---- AI voice interview (Bolna) — only if FEATURE_AI_INTERVIEW=true --------
INTERVIEW_PROVIDER=mock
INTERVIEW_PROVIDER_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
BOLNA_WEBCALL_SESSION_URL=
BOLNA_WEBHOOK_SECRET=
BOLNA_LLM_MODEL=gpt-4o-mini
BOLNA_VOICE_ID=

# ---- Redis (optional — enables distributed rate limiting) ------------------
REDIS_URL=

# ---- Auth provider ---------------------------------------------------------
AUTH_PROVIDER=supabase
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ---- AV scanning (ClamAV daemon) — feature-flagged ------------------------
CLAMD_HOST=
CLAMD_PORT=3310

# ---- Observability -----------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---- Feature flags (true/false) --------------------------------------------
FEATURE_CODING_ASSESSMENT=false
FEATURE_AI_INTERVIEW=false
FEATURE_WORKFLOW_AUTOMATION=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_AV_SCANNING=false
FEATURE_OUTBOUND_WEBHOOKS=false
FEATURE_GDPR_TOOLS=false
FEATURE_OFFER_MANAGEMENT=true
FEATURE_BULK_IMPORT=false

# ---- Worker ------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1500
WORKER_MAX_ATTEMPTS=4

# ============================================================================
# Frontend (Next.js on Vercel) — set these in Vercel's Environment Variables,
# not just here; Vercel does not read a root .env file from the monorepo.
# ============================================================================
NEXT_PUBLIC_API_URL=https://api.fluxberry.in
NEXT_PUBLIC_APP_URL=https://fluxberry.in
NEXT_PUBLIC_APP_NAME=Fluxberry
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# MUST be false in production — pairs with AUTH_ALLOW_TEST_TOKENS above.
NEXT_PUBLIC_AUTH_ALLOW_TEST_TOKENS=false
