# ============================================================================
# Fluxberry — environment variables
# Copy this file to `.env` and fill in values. Every variable is documented.
# The app runs with ZERO external keys: when a provider's keys are missing,
# a realistic MOCK adapter activates automatically (see MOCK_EXTERNAL_SERVICES).
# ============================================================================

# ---- App identity (branding comes from config, never hard-coded) -----------
APP_NAME=Fluxberry

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Backend API port
PORT=4000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000
# The externally-reachable URL of THIS backend. Optional — the app derives
# this from the incoming request by default (works fine for localhost and
# most proxied/tunneled dev setups), so only set it if that guess is wrong
# for your environment. Also used to build the Google Calendar redirect URI.
PUBLIC_API_URL=

# ---- Database --------------------------------------------------------------
# Local dev: mongodb://127.0.0.1:27017/fluxberry
# Prod: your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/fluxberry

# ---- Auth (Supabase) -------------------------------------------------------
# Backend verifies the Supabase-issued JWT. For local/E2E without Supabase,
# leave these blank and set AUTH_ALLOW_TEST_TOKENS=true (dev only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The project's JWT secret (Supabase dashboard > Settings > API > JWT Secret).
# Used to verify HS256 access tokens on the backend.
SUPABASE_JWT_SECRET=
# Dev-only: accept signed test tokens so E2E/local can auth without Supabase.
AUTH_ALLOW_TEST_TOKENS=true
# Secret used to mint/verify dev test tokens (dev only).
AUTH_TEST_TOKEN_SECRET=dev-only-insecure-test-secret
# Dev-only escape hatch: restores a fixed dev user + owner-everywhere role with
# no real membership check. NEVER a supported production mode — see below.
AUTH_BYPASS_ENABLED=false

# ---- Providers: master switch ----------------------------------------------
# true  -> force mock adapters for ALL external services (great for tests/offline)
# false -> use real adapter when its keys are present, else fall back to mock
MOCK_EXTERNAL_SERVICES=false

# ---- AI provider -----------------------------------------------------------
# one of: anthropic | openai | mock
AI_PROVIDER=anthropic
AI_API_KEY=
# Model id (defaults chosen per provider if blank)
AI_MODEL=

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Fluxberry <noreply@example.com>

# ---- Candidate messaging ----------------------------------------------------
# Reply-To domain for ad-hoc recruiter messages (application+<id>@this-domain).
# Inbound parsing is provider-agnostic — point whichever inbound email vendor
# you pick at POST /api/v1/webhooks/inbound-email/<secret>.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# ---- Billing (Dodo Payments) ------------------------------------------------
# Unlike the other providers, blank Dodo credentials alone do NOT fall back to
# the mock provider (the billing webhook is a public, unauthenticated route —
# a misconfigured real provider must fail closed, not silently accept
# unsigned events). Set MOCK_EXTERNAL_SERVICES=true to use the mock billing
# provider — checkout/webhook flows work fully offline for dev/tests.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# test_mode -> test.dodopayments.com, live_mode -> live.dodopayments.com
DODO_ENVIRONMENT=test_mode
# The Dodo product/price id billed for the PRO plan, monthly cycle ($40/mo).
DODO_PRO_PRODUCT_ID=
# The Dodo product/price id billed for the PRO plan, annual cycle ($200/yr).
DODO_PRO_PRODUCT_ID_ANNUAL=

# ---- Object storage (S3-compatible: Cloudflare R2 or AWS S3) ---------------
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=fluxberry-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public base for objects if your bucket is fronted by a CDN (optional)
STORAGE_PUBLIC_URL=

# ---- Coding execution (Judge0) — feature-flagged ---------------------------
# Base URL of a Judge0 instance (self-hosted :2358, RapidAPI, Sulu, etc.).
# Blank -> a realistic mock grader activates (feature runs with zero keys).
JUDGE0_URL=
JUDGE0_API_KEY=
# How the key is sent:
#   token    -> X-Auth-Token           (self-hosted Judge0 CE, default)
#   rapidapi -> X-RapidAPI-Key + Host   (also set JUDGE0_RAPIDAPI_HOST)
#   bearer   -> Authorization: Bearer   (Sulu / judge0.com gateway)
JUDGE0_AUTH_MODE=token
# Only for JUDGE0_AUTH_MODE=rapidapi, e.g. judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=

# ---- Google Calendar (interview scheduling) --------------------------------
# Blank -> a realistic mock calendar adapter activates: "Schedule interview"
# still works end-to-end (internal record + a fake meet link), no Google
# account is ever touched. Set these to make it create real Google Calendar
# events with an auto-generated Meet link, exactly like binary.so:
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
#      client ID (type: Web application).
#   2. Enable the "Google Calendar API" for the project.
#   3. Add an authorized redirect URI matching GOOGLE_CALENDAR_REDIRECT_URI
#      below (defaults to `${PUBLIC_API_URL}/api/v1/integrations/google-calendar/callback`).
#   4. Paste the client ID/secret here. A recruiter then connects their
#      calendar from Settings -> Integrations in the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ---- AI voice interview (Bolna) — feature-flagged --------------------------
# 'mock' (default) runs a realistic simulated interview with zero keys.
# Set 'bolna' + a bn- API key to use real Bolna voice agents.
INTERVIEW_PROVIDER=mock
INTERVIEW_PROVIDER_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
# Bolna browser web-call session-mint endpoint. The docs mark this a PLACEHOLDER
# (beta / request-access) — confirm the exact path with Bolna before going live.
BOLNA_WEBCALL_SESSION_URL=
# Unguessable secret in the Bolna webhook URL path (Bolna does not sign webhooks).
BOLNA_WEBHOOK_SECRET=
# Optional agent LLM/voice overrides.
BOLNA_LLM_MODEL=gpt-4o-mini
BOLNA_VOICE_ID=

# ---- Redis (optional — enables distributed rate limiting) ------------------
REDIS_URL=

# ---- Auth provider ---------------------------------------------------------
# 'supabase' (default) or 'clerk'. When 'clerk', the backend verifies Clerk
# JWTs instead of Supabase tokens.
AUTH_PROVIDER=supabase
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ---- AV scanning (ClamAV daemon) — feature-flagged ------------------------
CLAMD_HOST=
CLAMD_PORT=3310

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---- Feature flags (true/false) --------------------------------------------
FEATURE_CODING_ASSESSMENT=false
FEATURE_AI_INTERVIEW=false
FEATURE_WORKFLOW_AUTOMATION=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_AV_SCANNING=false
FEATURE_OUTBOUND_WEBHOOKS=false
FEATURE_GDPR_TOOLS=false
FEATURE_OFFER_MANAGEMENT=true
FEATURE_BULK_IMPORT=false

# ---- Worker ----------------------------------------------------------------
# How often (ms) the worker polls the Mongo job queue
WORKER_POLL_INTERVAL_MS=1500
# Max attempts before a job is dead-lettered
WORKER_MAX_ATTEMPTS=4

# ============================================================================
# Frontend (Next.js) — these are read at build/runtime by the web app.
# Keep NEXT_PUBLIC_* values safe to expose to the browser.
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fluxberry
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Dev-only: enables the test-token auth path in the web app for E2E.
NEXT_PUBLIC_AUTH_ALLOW_TEST_TOKENS=true
